# ============================================================
# AI Wealth Platform — environment variables
# Copy this file to `.env` and fill in your real values:
#     cp .env.example .env && nano .env && chmod 600 .env
# The platform auto-loads .env on startup. NEVER commit .env.
# ============================================================

# ---- LLM providers (at least ONE required) ------------------
# Groq (primary, free 14,400 req/day): https://console.groq.com
GROQ_API_KEY=

# Cerebras (free 1M tokens/day, same Llama 3.3 70B): https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Google Gemini (fallback, free 1,500 req/day, huge token allowance): https://aistudio.google.com
GEMINI_API_KEY=

# OpenRouter (free Llama 3.3 70B variant): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Anthropic Claude Haiku (OPTIONAL, ~Rs.60/mo) — used only by the
# Portfolio Manager agent for higher-quality final decisions
# ANTHROPIC_API_KEY=

# Ollama local fallback (OPTIONAL) — set USE_OLLAMA=1 only if Ollama
# is installed and running on this machine
# USE_OLLAMA=1
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# ---- Notifications (email via your nodemailer service) ------
# Your nodemailer endpoint; platform POSTs {"to","subject","text","html"}
EMAIL_SERVICE_URL=http://localhost:3001/send
EMAIL_TO=you@example.com
# Sent as "Authorization: Bearer <key>" if your mailer requires auth
# EMAIL_SERVICE_API_KEY=

# Telegram fallback (OPTIONAL — only used if email fails or is unset)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ---- Broker: Groww (free API) — needed only when broker=groww ----
# Generate at: Groww web -> profile -> Trading APIs
GROWW_API_KEY=
# Quote the secret if it contains special characters: 'p@ss^word'
GROWW_API_SECRET=''

# ---- Broker: Zerodha (legacy, Rs.500/month API) — optional ------
# ZERODHA_API_KEY=
# ZERODHA_SECRET_KEY=
# ZERODHA_ACCESS_TOKEN=        # expires daily; refresh with legacy_bot/zerodha_auth.py
